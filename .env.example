# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL / Prisma
DATABASE_URL=
DIRECT_URL=
# Optional: Supabase only if you use supabase-js
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Session auth
AUTH_PASSWORD=
AUTH_SECRET=

# --- Optional: fast offer extraction from a pasted screenshot (vision OCR) ---
# Leave OFFER_EXTRACTION_API_KEY empty to use the built-in offline text parser
# only (no image OCR). The UI auto-detects which mode to use.
OFFER_EXTRACTION_API_KEY=
# Provider: "openai" (default) or "gemini"
OFFER_EXTRACTION_PROVIDER=openai
# Model (defaults: gpt-4o-mini / gemini-2.0-flash)
# OFFER_EXTRACTION_MODEL=gpt-4o-mini
# Optional custom endpoint base URL
# OFFER_EXTRACTION_BASE_URL=
